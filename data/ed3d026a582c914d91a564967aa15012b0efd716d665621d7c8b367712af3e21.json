apter2%23lem%3Atransversal-representative-eq-gradient\" data-tex-node=\"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:transversal-representative-eq-gradient\" data-tex-anchor=\"tex-label-6c656d3a7472616e7376657273616c2d726570726573656e7461746976652d65712d6772616469656e74\">3</a> then give <span class=\"math\" data-display=\"false\" data-tex=\"$X_p=\\operatorname {grad}f|_p$\">$X_p=\\operatorname {grad}f|_p$</span>. </p><span class=\"qed\" aria-label=\"证毕\" style=\"display:block;text-align:right\">□</span></section>","warnings":["部分 TeX 排版细节未完整还原（已保留可读内容）: sketch"]},"previous":"references/LeeRiemannian/blueprint/src/chapters/chapter2#prob:grassmann-stiefel-manifolds","next":"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:transversal-representative-eq-gradient","relations":[{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:gradient","title":"def:gradient","label":"def:gradient"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:regular-set","title":"def:regular-set","label":"def:regular-set"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:gradient-characterization","title":"lem:gradient-characterization","label":"lem:gradient-characterization"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:transversal-representative-eq-gradient","title":"lem:transversal-representative-eq-gradient","label":"lem:transversal-representative-eq-gradient"}],"backlinks":[{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter6#cor:gradient-radial-distance","title":"cor:gradient-radial-distance","label":"cor:gradient-radial-distance"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter6#cor:distance-function-local-properties","title":"cor:distance-function-local-properties","label":"cor:distance-function-local-properties"}],"copy_context":{"version":1,"level":0,"node":"references/LeeRie