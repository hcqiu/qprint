-4-2-segment-length"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-segment-edist","title":"lem:dc-ch3-4-2-segment-edist","label":"lem:dc-ch3-4-2-segment-edist"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-join-metric","title":"lem:dc-ch3-4-2-join-metric","label":"lem:dc-ch3-4-2-join-metric"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-minimizing-interior","title":"lem:dc-ch3-4-2-minimizing-interior","label":"lem:dc-ch3-4-2-minimizing-interior"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-stronglyconvex-reduction","title":"lem:dc-ch3-4-2-stronglyconvex-reduction","label":"lem:dc-ch3-4-2-stronglyconvex-reduction"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-lowerbound","title":"lem:dc-ch3-4-2-lowerbound","label":"lem:dc-ch3-4-2-lowerbound"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-minimizing-interior-uncond","title":"lem:dc-ch3-4-2-minimizing-interior-uncond","label":"lem:dc-ch3-4-2-minimizing-interior-uncond"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-stronglyconvex-uniq","title":"lem:dc-ch3-4-2-stronglyconvex-uniq","label":"lem:dc-ch3-4-2-stronglyconvex-uniq"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-endpoint-id","title":"lem:dc-ch3-4-2-endpoint-id","label":"lem:dc-ch3-4-2-endpoint-id"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-competitor-lb","title":"lem:dc-ch3-4-2-competitor-lb","label":"lem:dc-ch3-4-2-competitor-lb"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-eqon-flow-reading","title":"lem:dc-ch3-4-2-eqon-flow-reading","label":"lem:dc-ch3-4-2-eqon-flow-reading"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-uniqueness-engine","title":"lem:dc-ch3-4-2-uniqueness-engine","label":"lem:dc-ch3-4-2-uniqueness-engine"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#def:dc-ch3-4-2-stronglyconvex","title":"def:dc-ch3-4-2-stronglyconvex","label":"def:dc-ch3-4-2-stronglyconvex"}],"backlinks":[],"copy_context":{"version":1,"level":0,"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#prop:dc-ch3-4-2","title":"prop:dc-ch3-4-2","tex":"\\begin{proposition}[convex neighborhoods]\n  \\label{prop:dc-ch3-4-2}\n\n  \\uses{thm:dc-ch3-3-7, lem:dc-ch3-4-1, lem:dc-ch3-4-1-strict, lem:dc-ch3-4-2-rebase, lem:dc-ch3-4-2-window, lem:dc-ch3-4-2-speed-dist, lem:dc-ch3-4-2-nomax, lem:dc-ch3-4-2-bridge, lem:dc-ch3-4-2-bridge-ball, lem:dc-ch3-4-2-maxdeduction, lem:dc-ch3-4-2-speedchart, lem:dc-ch3-4-2-velbound, lem:dc-ch3-4-2-interior, lem:dc-ch3-4-2-interior-minimizing, lem:dc-ch3-4-2-gramsmall, lem:dc-ch3-4-2-invdiagonal, lem:dc-ch3-4-2-pairsmall, lem:dc-ch3-4-2-velsmall, lem:dc-ch3-4-2-segment-length, lem:dc-ch3-4-2-segment-edist, lem:dc-ch3-4-2-join-metric, lem:dc-ch3-4-2-minimizing-interior, lem:dc-ch3-4-2-stronglyconvex-reduction, lem:dc-ch3-4-2-lowerbound, lem:dc-ch3-4-2-minimizing-interior-uncond, lem:dc-ch3-4-2-stronglyconvex-uniq, lem:dc-ch3-4-2-endpoint-id, lem:dc-ch3-4-2-competitor-lb, lem:dc-ch3-4-2-eqon-flow-reading, lem:dc-ch3-4-2-uniqueness-engine, def:dc-ch3-4-2-stronglyconvex}\n\n  \\dcref{ch3:4.2}\n  For any $p\\in M$ there exists $\\beta>0$ such that the closed geodesic ball $\\overline{B_\\beta(p)}$ is\n  strongly convex (\\cref{def:dc-ch3-4-2-stronglyconvex}). (The closed ball is used deliberately: the\n  literal open-ball form is unsatisfiable at a boundary diagonal, see below.)\n\\end{proposition}\n\\begin{proof}\n  \\sketch\n\n  Let $c$ be as in \\cref{lem:dc-ch3-4-1}. Choose $\\delta>0$ and $W$ as in \\cref{thm:dc-ch3-3-7}\n  with $\\delta<\\frac{c}{2}$, and take $\\beta<\\delta$ with $\\overline{B_\\beta(p)}\\subset W$. Let\n  $q_1,q_2\\in\\overline{B_\\beta(p)}$ and let $\\gamma$ be the unique geodesic of length\n  $<2\\delta<c$ joining them; then $\\gamma\\subset B_c(p)$. If the interior of\n  $\\gamma$ is not contained in $B_\\beta(p)$, there is an interior point $m$ where the\n  maximum distance $r$ from $p$ to $\\gamma$ is attained; near $m$ the points of\n  $\\gamma$ remain in $\\overline{B_r(p)}$. Since $m\\in B_c(p)$ this contradicts\n  \\cref{lem:dc-ch3-4-1-strict}: at $m$ the tangency $\\partial F/\\partial t(0)=0$ holds\n  (Gauss lemma) and the strict separation $F(0)<F(s)$ for $s\\neq0$ forces points of\n  $\\gamma$ near $m$ \\emph{strictly} outside $\\overline{B_r(p)}$, contradicting the\n  maximum. Hence the interior of $\\gamma$ lies in $B_\\beta(p)$, proving the proposition.\n\\end{proof}","source":"tex/references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods.tex","description":"","dependencies":[{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#thm:dc-ch3-3-7","title":"thm:dc-ch3-3-7","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-1","title":"lem:dc-ch3-4-1","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-1-strict","title":"lem:dc-ch3-4-1-strict","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-rebase","title":"lem:dc-ch3-4-2-rebase","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-window","title":"lem:dc-ch3-4-2-window","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-speed-dist","title":"lem:dc-ch3-4-2-speed-dist","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-nomax","title":"lem:dc-ch3-4-2-nomax","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-bridge","title":"lem:dc-ch3-4-2-bridge","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-bridge-ball","title":"lem:dc-ch3-4-2-bridge-ball","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-maxdeduction","title":"lem:dc-ch3-4-2-maxdeduction","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-speedchart","title":"lem:dc-ch3-4-2-speedchart","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-velbound","title":"lem:dc-ch3-4-2-velbound","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-interior","title":"lem:dc-ch3-4-2-interior","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-interior-minimizing","title":"lem:dc-ch3-4-2-interior-minimizing","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-gramsmall","title":"lem:dc-ch3-4-2-gramsmall","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-invdiagonal","title":"lem:dc-ch3-4-2-invdiagonal","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-pairsmall","title":"lem:dc-ch3-4-2-pairsmall","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-velsmall","title":"lem:dc-ch3-4-2-velsmall","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-segment-length","title":"lem:dc-ch3-4-2-segment-length","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-segment-edist","title":"lem:dc-ch3-4-2-segment-edist","description":""}],"dependencies_omitted":11,"unresolved_dependencies":[],"unresolved_omitted":0}}