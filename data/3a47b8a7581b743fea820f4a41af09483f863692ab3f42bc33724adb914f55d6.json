-ch7-3-4-pullback-metric","title":"lem:dc-ch7-3-4-pullback-metric","label":"lem:dc-ch7-3-4-pullback-metric"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch07_CompleteManifoldsHopfRinowHadamard#lem:dc-ch7-2-5-minimizing","title":"lem:dc-ch7-2-5-minimizing","label":"lem:dc-ch7-2-5-minimizing"}],"copy_context":{"version":1,"level":0,"node":"references/DoCarmo/blueprint/src/chapters/Ch07_CompleteManifoldsHopfRinowHadamard#def:dc-ch7-2-4","title":"def:dc-ch7-2-4","tex":"\\begin{definition}[distance]\n\n  \\label{def:dc-ch7-2-4}\n\n  \\uses{def:dc-ch1-2-9, def:dc-ch3-3-1}\n\n  \\dcref{ch7:2.4}\nThe \\emph{distance} $d(p,q)$ is defined by $d(p,q)=$ infimum of the lengths of all\n  curves $f_{p,q}$, where $f_{p,q}$ is a piecewise differentiable curve joining $p$\n  to $q$. Equivalently, one may take the infimum over curves that are smooth on\n  the subintervals of a finite partition.\n\\end{definition}\n\\begin{proof}\n\\sketch Additivity of length and the triangle inequality give one inequality.\n  Conversely, subdivide a $C^1$ path into small chart windows and replace each\n  piece by the pullback of a straight segment. Continuity of the chart Gram\n  forms makes the polygonal lengths converge to the original length.\n\\end{proof}","source":"tex/references/DoCarmo/blueprint/src/chapters/Ch07_CompleteManifoldsHopfRinowHadamard.tex","description":"","dependencies":[{"node":"references/DoCarmo/blueprint/src/chapters/Ch01_RiemannianMetrics#def:dc-ch1-2-9","title":"def:dc-ch1-2-9","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#def:dc-ch3-3-1","title":"def:dc-ch3-3-1","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}