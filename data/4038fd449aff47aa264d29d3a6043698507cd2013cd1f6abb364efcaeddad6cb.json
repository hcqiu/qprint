*\\nabla T+c\\operatorname{Ric}(T)=0\\}.\n  \\]\n  Then\n  \\[\n    \\dim V\\le\n    m\\cdot\\exp\\Big(2D\\cdot C(n,kD^2)\n      \\frac{\\sqrt{-kcC\\nu}}{\\sqrt{\\nu-1}}\\Big).\n  \\]\n  If $k=0$, all elements of $V$ are parallel.\n\\end{theorem}","source":"tex/references/Petersen/blueprint/src/chapters/Ch09_TheBochnerTechnique.tex","description":"","dependencies":[{"node":"references/Petersen/blueprint/src/chapters/Ch09_TheBochnerTechnique#cor:pet-ch9-ric-nonneg-curvature-operator","title":"cor:pet-ch9-ric-nonneg-curvature-operator","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch09_TheBochnerTechnique#thm:pet-ch9-gallot-connection-laplacian-estimate","title":"thm:pet-ch9-gallot-connection-laplacian-estimate","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch09_TheBochnerTechnique#prop:pet-ch9-vanishing-connection-laplacian","title":"prop:pet-ch9-vanishing-connection-laplacian","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}