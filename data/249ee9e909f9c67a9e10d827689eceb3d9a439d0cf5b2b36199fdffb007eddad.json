_1)\\otimes X_2+X_1\\otimes(\\nabla_XX_2)$.\n\\end{definition}","source":"tex/references/Petersen/blueprint/src/chapters/Ch02_Derivatives.tex","description":"","dependencies":[{"node":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#def:pet-ch2-riemannian-connection","title":"def:pet-ch2-riemannian-connection","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}