ilde g)\\to (M,g)$\">$\\pi :(\\tilde M,\\tilde g)\\to (M,g)$</span> is a <em>Riemannian submersion</em> if <span class=\"math\" data-display=\"true\" data-tex=\"\\[  g_{\\pi (x)}(d\\pi _xv,d\\pi _xw)=\\tilde g_x(v,w)\\qquad (v,w\\in H_x).  \\]\">\\[  g_{\\pi (x)}(d\\pi _xv,d\\pi _xw)=\\tilde g_x(v,w)\\qquad (v,w\\in H_x).  \\]</span> ","warnings":[]},"previous":"references/LeeRiemannian/blueprint/src/chapters/chapter2#ex:riemannian-submersions","next":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:submersion-inner","relations":[{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:submersion","title":"def:submersion","label":"def:submersion"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:horizontal-space","title":"def:horizontal-space","label":"def:horizontal-space"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:riemannian-metric","title":"def:riemannian-metric","label":"def:riemannian-metric"}],"backlinks":[{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#ex:riemannian-submersions","title":"ex:riemannian-submersions","label":"ex:riemannian-submersions"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:riemannian-submersion-inner-eq","title":"lem:riemannian-submersion-inner-eq","label":"lem:riemannian-submersion-inner-eq"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#thm:group-action-riemannian-submersion","title":"thm:group-action-riemannian-submersion","label":"thm:group-action-riemannian-submersion"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#prop:equidimensional-riemannian-submersion-local-isometry","title":"prop:equidimensional-riemannian-submersion-local-isometry","label":"prop:equidimensional-riemannian-submersion-local-isometry"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter7#prop:oneill-formula","title":"prop:oneill-formula","label":"prop:oneill-formula"}],"copy_context":{"version":1,"level":0,"node":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:riemannian-submersion","title":"def:riemannian-submersion","tex":"\\begin{definition}[Riemannian submersion]\n\\label{def:riemannian-submersion}\n\n\\uses{def:submersion, def:horizontal-space, def:riemannian-metric}\n\n\n\n\nA smooth submersion $\\pi:(\\tilde M,\\tilde g)\\to(M,g)$ is a \\emph{Riemannian submersion} if\n\\[\ng_{\\pi(x)}(d\\pi_xv,d\\pi_xw)=\\tilde g_x(v,w)\\qquad(v,w\\in H_x).\n\\]\n\\end{definition}","source":"tex/references/LeeRiemannian/blueprint/src/chapters/chapter2.tex","description":"","dependencies":[{"node":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:submersion","title":"def:submersion","description":""},{"node":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:horizontal-space","title":"def:horizontal-space","description":""},{"node":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:riemannian-metric","title":"def:riemannian-metric","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}