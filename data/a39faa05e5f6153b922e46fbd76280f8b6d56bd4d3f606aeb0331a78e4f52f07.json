\\{M(u)>t\\}\\le C\\int|u|\\).\n\\end{proof}","source":"tex/references/Petersen/blueprint/src/chapters/Ch07_RicciCurvatureComparison.tex","description":"","dependencies":[{"node":"references/Petersen/blueprint/src/chapters/Ch07_RicciCurvatureComparison#def:pet-ch7-maximal-function","title":"def:pet-ch7-maximal-function","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch07_RicciCurvatureComparison#lem:pet-ch7-relative-volume-comparison","title":"lem:pet-ch7-relative-volume-comparison","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch07_RicciCurvatureComparison#rem:pet-ch7-ex-5","title":"rem:pet-ch7-ex-5","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}