ata-tex=\"$B(\\mathrm{ad}_XY,Z)+B(Y,\\mathrm{ad}_XZ)=0$\">$B(\\mathrm{ad}_XY,Z)+B(Y,\\mathrm{ad}_XZ)=0$</span>. ","warnings":[]},"previous":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#prop:pet-ch10-lie-bracket-curvature","next":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#rem:pet-ch10-adjoint-skew-symmetric","relations":[],"backlinks":[{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#rem:pet-ch10-adjoint-skew-symmetric","title":"rem:pet-ch10-adjoint-skew-symmetric","label":"rem:pet-ch10-adjoint-skew-symmetric"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#thm:pet-ch10-curvature-bracket-formula","title":"thm:pet-ch10-curvature-bracket-formula","label":"thm:pet-ch10-curvature-bracket-formula"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#ex:pet-ch10-compact-grassmannian","title":"ex:pet-ch10-compact-grassmannian","label":"ex:pet-ch10-compact-grassmannian"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#ex:pet-ch10-lie-group-symmetric","title":"ex:pet-ch10-lie-group-symmetric","label":"ex:pet-ch10-lie-group-symmetric"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#rem:pet-ch10-exercise-killing-form-classical","title":"rem:pet-ch10-exercise-killing-form-classical","label":"rem:pet-ch10-exercise-killing-form-classical"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#rem:pet-ch10-exercise-sum-in-so","title":"rem:pet-ch10-exercise-sum-in-so","label":"rem:pet-ch10-exercise-sum-in-so"}],"copy_context":{"version":1,"level":0,"node":"references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy#def:pet-ch10-killing-form","title":"def:pet-ch10-killing-form","tex":"\\begin{definition}[adjoint action and Killing form]\n  \\label{def:pet-ch10-killing-form}\n\n  \\source{petersen:page-0385}\n  For a finite-dimensional Lie algebra $\\mathfrak g$, define\n  \\[\n    \\mathrm{ad}_X(Y)=[X,Y],\\qquad\n    B(X,Y)=\\operatorname{tr}(\\mathrm{ad}_X\\mathrm{ad}_Y).\n  \\]\n  The Killing form $B$ is symmetric and invariant:\n  $B(\\mathrm{ad}_XY,Z)+B(Y,\\mathrm{ad}_XZ)=0$.\n\\end{definition}","source":"tex/references/Petersen/blueprint/src/chapters/Ch10_SymmetricSpacesAndHolonomy.tex","description":"","dependencies":[],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}