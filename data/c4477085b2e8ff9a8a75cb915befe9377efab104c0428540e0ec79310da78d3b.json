{"id":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#def:pet-ch2-parallel-tensor","title":"def:pet-ch2-parallel-tensor","path":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives.md","line":408,"body":"","kind":"definition","status":"not_started","tex":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives.tex#def:pet-ch2-parallel-tensor","uses":["[[references/Petersen/blueprint/src/chapters/Ch02_Derivatives#def:pet-ch2-covariant-derivative-tensor]]"],"inspired_by":[],"bindings":[],"is_index":false,"body_html":"","formal":[],"tex_content":{"path":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives.tex","label":"def:pet-ch2-parallel-tensor","line":847,"source":"\\begin{definition}[parallel tensor]\n  \\label{def:pet-ch2-parallel-tensor}\n\n  \\source{petersen:page-0075}\n  \\uses{def:pet-ch2-covariant-derivative-tensor}\n\n  A tensor $S$ is \\emph{parallel} if $\\nabla S=0$. On Euclidean space, a\n  tensor written in Cartesian coordinates is parallel iff it has constant\n  coefficients.\n\\end{definition}","html":" <p></p><section class=\"theorem\"><div class=\"theorem-label\">Definition</div></section>[parallel tensor] <span class=\"tex-label\" id=\"tex-label-6465663a7065742d6368322d706172616c6c656c2d74656e736f72\"></span> <p></p><span class=\"tex-source\" style=\"display:block\">Source: <span class=\"reference\">petersen:page-0075</span></span> <a class=\"wikilink tex-use\" href=\"#node=references%2FPetersen%2Fblueprint%2Fsrc%2Fchapters%2FCh02_Derivatives%23def%3Apet-ch2-covariant-derivative-tensor\">↗ def:pet-ch2-covariant-derivative-tensor</a> <p></p>A tensor <span class=\"math\" data-display=\"false\" data-tex=\"$S$\">$S$</span> is <em>parallel</em> if <span class=\"math\" data-display=\"false\" data-tex=\"$\\nabla S=0$\">$\\nabla S=0$</span>. On Euclidean space, a tensor written in Cartesian coordinates is parallel iff it has constant coefficients. ","warnings":[]},"previous":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#def:pet-ch2-covariant-derivative-tensor","next":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#prop:pet-ch2-metric-volume-parallel","relations":[{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#def:pet-ch2-covariant-derivative-tensor","title":"def:pet-ch2-covariant-derivative-tensor","label":"def:pet-ch2-covariant-derivative-tensor"}],"backlinks":[{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#prop:pet-ch2-metric-volume-parallel","title":"prop:pet-ch2-metric-volume-parallel","label":"prop:pet-ch2-metric-volume-parallel"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#rem:pet-ch2-ex-31","title":"rem:pet-ch2-ex-31","label":"rem:pet-ch2-ex-31"}],"copy_context":{"version":1,"level":0,"node":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#def:pet-ch2-parallel-tensor","title":"def:pet-ch2-parallel-tensor","tex":"\\begin{definition}[parallel tensor]\n  \\label{def:pet-ch2-parallel-tensor}\n\n  \\source{petersen:page-0075}\n  \\uses{def:pet-ch2-covariant-derivative-tensor}\n\n  A tensor $S$ is \\emph{parallel} if $\\nabla S=0$. On Euclidean space, a\n  tensor written in Cartesian coordinates is parallel iff it has constant\n  coefficients.\n\\end{definition}","source":"tex/references/Petersen/blueprint/src/chapters/Ch02_Derivatives.tex","description":"","dependencies":[{"node":"references/Petersen/blueprint/src/chapters/Ch02_Derivatives#def:pet-ch2-covariant-derivative-tensor","title":"def:pet-ch2-covariant-derivative-tensor","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}