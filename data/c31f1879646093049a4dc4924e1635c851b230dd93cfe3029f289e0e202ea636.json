:"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#defnepsround","next":"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#def:strong-epsilon-neck-canonical-neighborhood","relations":[{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch02_ManifoldsNonNegativeCurvature#def:epsilon-neck","title":"def:epsilon-neck","label":"def:epsilon-neck"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#def:c-epsilon-cap","title":"def:c-epsilon-cap","label":"def:c-epsilon-cap"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#def:c-component","title":"def:c-component","label":"def:c-component"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#def:epsilon-round-component","title":"def:epsilon-round-component","label":"def:epsilon-round-component"}],"backlinks":[{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#prop:canonical-neighborhood-stability","title":"prop:canonical-neighborhood-stability","label":"prop:canonical-neighborhood-stability"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#cor:canonical-neighborhood-existence","title":"cor:canonical-neighborhood-existence","label":"cor:canonical-neighborhood-existence"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch14_RicciFlowWithSurgery#def:strong-canonical-neighborhood-assumption","title":"def:strong-canonical-neighborhood-assumption","label":"def:strong-canonical-neighborhood-assumption"}],"copy_context":{"version":1,"level":0,"node":"references/MorganTian/blueprint/src/chapters/Ch09_KappaAncientSolutions#def:canonical-neighborhood","title":"def:canonical-neighborhood","tex":"\\begin{definition}[$(C,\\epsilon)$-canonical neighborhood]\\label{def:canonical-neighborhood}\n\\uses{def:epsilon-neck, def:c-epsilon-cap, def:c-component, 