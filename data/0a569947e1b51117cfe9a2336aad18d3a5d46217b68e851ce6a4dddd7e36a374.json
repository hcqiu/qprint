GeodesicsConvexNeighborhoods.tex","description":"","dependencies":[{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-minimizing-interior","title":"lem:dc-ch3-4-2-minimizing-interior","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-lowerbound","title":"lem:dc-ch3-4-2-lowerbound","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}