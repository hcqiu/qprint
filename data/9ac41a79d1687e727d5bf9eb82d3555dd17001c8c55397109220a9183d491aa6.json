ch5-hopf-rinow","title":"thm:pet-ch5-hopf-rinow","label":"thm:pet-ch5-hopf-rinow"}],"backlinks":[{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch05_GeodesicsAndDistance#prop:pet-ch5-segment-domain-injective","title":"prop:pet-ch5-segment-domain-injective","label":"prop:pet-ch5-segment-domain-injective"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch05_GeodesicsAndDistance#rem:pet-ch5-segment-domain-chart-artifact","title":"rem:pet-ch5-segment-domain-chart-artifact","label":"rem:pet-ch5-segment-domain-chart-artifact"},{"kind":"uses","id":"references/Petersen/blueprint/src/chapters/Ch05_GeodesicsAndDistance#def:pet-ch5-cut-locus","title":"def:pet-ch5-cut-locus","label":"def:pet-ch5-cut-locus"}],"copy_context":{"version":1,"level":0,"node":"references/Petersen/blueprint/src/chapters/Ch05_GeodesicsAndDistance#def:pet-ch5-segment-domain","title":"def:pet-ch5-segment-domain","tex":"\\begin{definition}[segment domain and its star interior]\n  \\label{def:pet-ch5-segment-domain}\n\n  \\source{petersen:page-0232,petersen:page-0233}\n  \\uses{def:pet-ch5-segment, thm:pet-ch5-hopf-rinow}\n\n  For a complete $(M,g)$ and $p\\in M$, the \\emph{segment domain} is\n  $\\operatorname{seg}(p)=\\{v\\in T_pM\\mid\\exp_p(tv):[0,1]\\to M\\text{ is a segment}\\}$,\n  a closed star-shaped set with $M=\\exp_p(\\operatorname{seg}(p))$ (by\n  \\cref{thm:pet-ch5-hopf-rinow}). Its \\emph{star interior} is\n  $\\operatorname{seg}^0(p)=\\{sv\\mid s\\in[0,1),\\,v\\in\\operatorname{seg}(p)\\}$.\n\\end{definition}","source":"tex/references/Petersen/blueprint/src/chapters/Ch05_GeodesicsAndDistance.tex","description":"","dependencies":[{"node":"references/Petersen/blueprint/src/chapters/Ch05_GeodesicsAndDistance#def:pet-ch5-segment","title":"def:pet-ch5-segment","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch05_GeodesicsAndDistance#thm:pet-ch5-hopf-rinow","title":"thm:pet-ch5-hopf-rinow","description":""}],"dependencies_omitted":0,"unresol