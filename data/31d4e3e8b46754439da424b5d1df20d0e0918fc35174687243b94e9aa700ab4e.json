b","title":"lem:dc-ch3-4-2-competitor-lb","label":"lem:dc-ch3-4-2-competitor-lb"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-stronglyconvex-reduction","title":"lem:dc-ch3-4-2-stronglyconvex-reduction","label":"lem:dc-ch3-4-2-stronglyconvex-reduction"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-eqon-flow-reading","title":"lem:dc-ch3-4-2-eqon-flow-reading","label":"lem:dc-ch3-4-2-eqon-flow-reading"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-4-2-uniqueness-engine","title":"lem:dc-ch3-4-2-uniqueness-engine","label":"lem:dc-ch3-4-2-uniqueness-engine"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#prop:dc-ch3-4-2","title":"prop:dc-ch3-4-2","label":"prop:dc-ch3-4-2"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch07_CompleteManifoldsHopfRinowHadamard#prop:dc-ch7-2-3","title":"prop:dc-ch7-2-3","label":"prop:dc-ch7-2-3"},{"kind":"uses","id":"references/DoCarmo/blueprint/src/chapters/Ch09_VariationsOfEnergy#prop:dc-ch9-2-2","title":"prop:dc-ch9-2-2","label":"prop:dc-ch9-2-2"}],"copy_context":{"version":1,"level":0,"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#thm:dc-ch3-3-7","title":"thm:dc-ch3-3-7","tex":"\\begin{theorem}[totally normal neighborhood]\n  \\label{thm:dc-ch3-3-7}\n\n  \\uses{prop:dc-ch3-2-7, lem:dc-ch3-3-7-descent, lem:dc-ch3-3-7-descent-velocity, lem:dc-ch3-3-7-pairmap, lem:dc-ch3-3-7-c1pair}\n\n  \\dcref{ch3:3.7}\n  For any $p\\in M$ there exist a neighborhood $W$ of $p$ and a number $\\delta>0$\n  such that for every $q\\in W$, $\\exp_q$ is a diffeomorphism on\n  $B_\\delta(0)\\subset T_qM$ and $\\exp_q(B_\\delta(0))\\supset W$; that is, $W$ is a\n  normal neighborhood of each of its points.\n\\end{theorem}\n\\begin{proof}\n  \\sketch\n\n  \\uses{lem:dc-ch3-3-7-descent, lem:dc-ch3-3-7-descent-velocity, lem:dc-ch3-3-7-pairmap, lem:dc-ch3-3-7-c1pair, lem:dc-ch3-3-7-invertible}\n  Let $\\varepsilon$, $V$, $\\mathcal{U}$ be as in \\cref{prop:dc-ch3-2-7}, with\n  $\\mathcal{U}\\subset TU$, $V\\subset\\mathbf{x}(U)$. Define $F:\\mathcal{U}\\to M\\times M$\n  by $F(q,v)=(q,\\exp_q v)$. Around $F(p,0)=(p,p)$ take coordinates\n  $(U\\times U;\\mathbf{x},\\mathbf{x})$; then since $(d\\exp_p)_0=I$,\n\n  $$\n  dF_{(p,0)}=\\begin{pmatrix}I & I\\\\ 0 & I\\end{pmatrix},\n  $$\n\n  so $F$ is a local diffeomorphism near $(p,0)$, mapping a neighborhood\n  $\\mathcal{U}'=\\{(q,v);\\ q\\in V',\\ v\\in T_qM,\\ |v|<\\delta\\}$ diffeomorphically onto\n  a neighborhood $W'$ of $(p,p)$. Choose $W\\ni p$ with $W\\times W\\subset W'$. For\n  $q\\in W$ and $B_\\delta(0)\\subset T_qM$, $F(\\{q\\}\\times B_\\delta(0))\\supset\\{q\\}\\times W$,\n  so by definition of $F$, $\\exp_q(B_\\delta(0))\\supset W$.\n\\end{proof}","source":"tex/references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods.tex","description":"","dependencies":[{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#prop:dc-ch3-2-7","title":"prop:dc-ch3-2-7","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-3-7-descent","title":"lem:dc-ch3-3-7-descent","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-3-7-descent-velocity","title":"lem:dc-ch3-3-7-descent-velocity","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-3-7-pairmap","title":"lem:dc-ch3-3-7-pairmap","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-3-7-c1pair","title":"lem:dc-ch3-3-7-c1pair","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch03_GeodesicsConvexNeighborhoods#lem:dc-ch3-3-7-invertible","title":"lem:dc-ch3-3-7-invertible","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}