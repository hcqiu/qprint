t}-\\Gamma^t_{il}\\Gamma^s_{jt}).\n\\end{align*}\n\n\\begin{lemma}[Curvature symmetries and Bianchi identities]","source":"tex/references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries.tex","description":"","dependencies":[{"node":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#thm:levi-civita-connection","title":"thm:levi-civita-connection","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}