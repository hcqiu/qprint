}  R_{ijkl} &amp; =\\mathcal R(\\partial _i,\\partial _j,\\partial _k,\\partial _l)\\\\ &amp; =g_{ks}{{R_{ij}}^s}_l\\\\ &amp; =g_{ks}(\\partial _i\\Gamma ^s_{jl}-\\partial _j\\Gamma ^s_{il} +\\Gamma ^t_{jl}\\Gamma ^s_{it}-\\Gamma ^t_{il}\\Gamma ^s_{jt}). \\end{align*}</span> <p></p><section class=\"theorem\"><div class=\"theorem-label\">Lemma</div></section>[Curvature symmetries and Bianchi identities]","warnings":[]},"previous":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#laplacformula","next":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#claim:curvature-symmetries-bianchi","relations":[{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#thm:levi-civita-connection","title":"thm:levi-civita-connection","label":"thm:levi-civita-connection"}],"backlinks":[{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#claim:curvature-symmetries-bianchi","title":"claim:curvature-symmetries-bianchi","label":"claim:curvature-symmetries-bianchi"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#Bianchi","title":"Bianchi","label":"Bianchi"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#def:sectional-curvature","title":"def:sectional-curvature","label":"def:sectional-curvature"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#def:curvature-operator","title":"def:curvature-operator","label":"def:curvature-operator"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#def:ricci-curvature","title":"def:ricci-curvature","label":"def:ricci-curvature"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#lem:ricci-trace-curvature-operator","title":"lem:ricci-trace-curvature-operator","label":"lem:ricci-trace-curvature-operator"},{"kind":"uses","id":"references/MorganTian/blueprint/src/chapters/Ch01_Preliminaries#le