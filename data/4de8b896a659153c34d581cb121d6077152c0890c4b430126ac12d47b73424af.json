em:pet-ch6-nonsingular-exp-covering} gives the universal cover \\(T_pM\\cong\\mathbb R^n\\).\n\\end{proof}","source":"tex/references/Petersen/blueprint/src/chapters/Ch06_SectionalCurvatureComparisonI.tex","description":"","dependencies":[{"node":"references/Petersen/blueprint/src/chapters/Ch06_SectionalCurvatureComparisonI#lem:pet-ch6-nonsingular-exp-covering","title":"lem:pet-ch6-nonsingular-exp-covering","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch06_SectionalCurvatureComparisonI#def:pet-ch6-sec-bounds","title":"def:pet-ch6-sec-bounds","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch06_SectionalCurvatureComparisonI#def:pet-ch6-jacobi-field","title":"def:pet-ch6-jacobi-field","description":""},{"node":"references/Petersen/blueprint/src/chapters/Ch06_SectionalCurvatureComparisonI#rem:pet-ch6-jacobi-dexp-relation","title":"rem:pet-ch6-jacobi-dexp-relation","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}