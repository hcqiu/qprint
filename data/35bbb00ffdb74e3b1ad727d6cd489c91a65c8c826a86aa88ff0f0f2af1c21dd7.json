:"tex/references/MorganTian/blueprint/src/chapters/Ch02_ManifoldsNonNegativeCurvature.tex","description":"","dependencies":[{"node":"references/MorganTian/blueprint/src/chapters/Ch02_ManifoldsNonNegativeCurvature#def:minimizing-geodesic-ray","title":"def:minimizing-geodesic-ray","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}