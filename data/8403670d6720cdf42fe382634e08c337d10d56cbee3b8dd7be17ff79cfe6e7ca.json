igation.\n\\end{lemma}","source":"tex/references/DoCarmo/blueprint/src/chapters/Ch08_SpacesOfConstantCurvature.tex","description":"","dependencies":[{"node":"references/DoCarmo/blueprint/src/chapters/Ch08_SpacesOfConstantCurvature#lem:dc-ch8-2-1-frame-chart-interface","title":"lem:dc-ch8-2-1-frame-chart-interface","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch08_SpacesOfConstantCurvature#lem:dc-ch8-2-1-jacobi-norm-transfer-general","title":"lem:dc-ch8-2-1-jacobi-norm-transfer-general","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch08_SpacesOfConstantCurvature#lem:dc-ch8-2-1-jacobi-norm-transfer-manifold","title":"lem:dc-ch8-2-1-jacobi-norm-transfer-manifold","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/formalization-support#lem:dc-ch8-2-1-chart-partition","title":"lem:dc-ch8-2-1-chart-partition","description":""},{"node":"references/DoCarmo/blueprint/src/chapters/Ch08_SpacesOfConstantCurvature#lem:dc-ch8-2-1-radial-chart","title":"lem:dc-ch8-2-1-radial-chart","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}