 data-display=\"true\" data-tex=\"\\[  \\pi _1(X)\\cong *_\\alpha \\pi _1(A_\\alpha )/N.  \\]\">\\[  \\pi _1(X)\\cong *_\\alpha \\pi _1(A_\\alpha )/N.  \\]</span> ","warnings":["部分 TeX 排版细节未完整还原（已保留可读内容）: group"]},"previous":"references/Hatcher/blueprint/src/chapters/chapter1#prop:free-product-universal-property","next":"references/Hatcher/blueprint/src/chapters/chapter1#ex:wedge-sum-fundamental-group","relations":[{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/chapter1#prop:free-product-universal-property","title":"prop:free-product-universal-property","label":"prop:free-product-universal-property"},{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/chapter1#lem:loop-decomposition-open-cover","title":"lem:loop-decomposition-open-cover","label":"lem:loop-decomposition-open-cover"},{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/formalization-support#lem:van-kampen-rectangular-subdivision","title":"lem:van-kampen-rectangular-subdivision","label":"lem:van-kampen-rectangular-subdivision"},{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/formalization-support#lem:van-kampen-grid-cell-sweep","title":"lem:van-kampen-grid-cell-sweep","label":"lem:van-kampen-grid-cell-sweep"}],"backlinks":[{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/chapter1#ex:wedge-sum-fundamental-group","title":"ex:wedge-sum-fundamental-group","label":"ex:wedge-sum-fundamental-group"},{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/chapter1#ex:linking-of-circles-fundamental-groups","title":"ex:linking-of-circles-fundamental-groups","label":"ex:linking-of-circles-fundamental-groups"},{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/chapter1#ex:torus-knot-complement-fundamental-group","title":"ex:torus-knot-complement-fundamental-group","label":"ex:torus-knot-complement-fundamental-group"},{"kind":"uses","id":"references/Hatcher/blueprint/src/chapters/chapter1#prop:attaching-cells-pi1","title":"prop:att