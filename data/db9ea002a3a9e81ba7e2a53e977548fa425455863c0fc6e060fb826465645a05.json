display=\"false\" data-tex=\"$(V_x,g_x)$\">$(V_x,g_x)$</span> to the nondegenerate tuple <span class=\"math\" data-display=\"false\" data-tex=\"$(X_i|_x)$\">$(X_i|_x)$</span>. </p><span class=\"qed\" aria-label=\"证毕\" style=\"display:block;text-align:right\">□</span></section>","warnings":["部分 TeX 排版细节未完整还原（已保留可读内容）: sketch"]},"previous":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:pseudo-gram-schmidt-frame","next":"references/LeeRiemannian/blueprint/src/chapters/chapter2#prop:pseudo-gram-schmidt-frame-orthonormal","relations":[{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:pseudo-gram-schmidt-frame","title":"def:pseudo-gram-schmidt-frame","label":"def:pseudo-gram-schmidt-frame"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#def:local-nondegenerate-family","title":"def:local-nondegenerate-family","label":"def:local-nondegenerate-family"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:gram-schmidt-bilin-nonvanishing","title":"lem:gram-schmidt-bilin-nonvanishing","label":"lem:gram-schmidt-bilin-nonvanishing"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:pseudo-metric-fibre-scalar-product","title":"lem:pseudo-metric-fibre-scalar-product","label":"lem:pseudo-metric-fibre-scalar-product"}],"backlinks":[{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#prop:pseudo-gram-schmidt-frame-aux-smooth","title":"prop:pseudo-gram-schmidt-frame-aux-smooth","label":"prop:pseudo-gram-schmidt-frame-aux-smooth"},{"kind":"uses","id":"references/LeeRiemannian/blueprint/src/chapters/chapter2#prop:pseudo-gram-schmidt-frame-smooth","title":"prop:pseudo-gram-schmidt-frame-smooth","label":"prop:pseudo-gram-schmidt-frame-smooth"}],"copy_context":{"version":1,"level":0,"node":"references/LeeRiemannian/blueprint/src/chapters/chapter2#lem:pseudo-gram-schmidt-denominators","title":"lem:pseudo-gram-schmidt-denominators