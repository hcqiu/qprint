ad +B(X,W,Y,Z)-B(X,Z,Y,W)\\bigr). \\end{align*}\">\\begin{align*}  (\\Delta \\Rm )(X,Y,W,Z)={}&amp; -\\nabla ^2_{Y,W}\\Ric (X,Z)+\\nabla ^2_{X,W}\\Ric (Y,Z)\\\\ &amp; -\\nabla ^2_{X,Z}\\Ric (Y,W)+\\nabla ^2_{Y,Z}\\Ric (X,W)\\\\ &amp; -\\Ric (R(W,Z)Y,X)+\\Ric (R(W,Z)X,Y)\\\\ &amp; -2\\bigl(B(X,Y,W,Z)-B(X,Y,Z,W)\\\\ &amp; \\qquad +B(X,W,Y,Z)-B(X,Z,Y,W)\\bigr). \\end{align*}</span> ","warnings":["部分 TeX 排版细节未完整还原（已保留可读内容）: group"]},"previous":"references/Topping/blueprint/src/chapters/Ch02#topping:variation-volume-form","next":"references/Topping/blueprint/src/chapters/Ch02#topping:ricci-flow-curvature-evolution","relations":[],"backlinks":[],"copy_context":{"version":1,"level":0,"node":"references/Topping/blueprint/src/chapters/Ch02#topping:laplacian-curvature-tensor","title":"topping:laplacian-curvature-tensor","tex":"\\begin{proposition}[Rough Laplacian of curvature]\n\\dcref{ch2:4.1}\n\\label{topping:laplacian-curvature-tensor}\n\\source{topping:page-0041,topping:page-0042}\n\\group{topping-background}\n\n\\begin{align*}\n(\\Delta\\Rm)(X,Y,W,Z)={}&-\\nabla^2_{Y,W}\\Ric(X,Z)+\\nabla^2_{X,W}\\Ric(Y,Z)\\\\\n&-\\nabla^2_{X,Z}\\Ric(Y,W)+\\nabla^2_{Y,Z}\\Ric(X,W)\\\\\n&-\\Ric(R(W,Z)Y,X)+\\Ric(R(W,Z)X,Y)\\\\\n&-2\\bigl(B(X,Y,W,Z)-B(X,Y,Z,W)\\\\\n&\\qquad+B(X,W,Y,Z)-B(X,Z,Y,W)\\bigr).\n\\end{align*}\n\\end{proposition}","source":"tex/references/Topping/blueprint/src/chapters/Ch02.tex","description":"","dependencies":[],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}