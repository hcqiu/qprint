{k=0}^N\\psi_k(\\tau-v)^k.\n\\]\nIn polar coordinates about \\(y\\), write\n\\(\\alpha_\\tau=\\sqrt{\\det g^S(\\tau)}/r_\\tau^{n-1}\\).","source":"tex/references/ChowEtAl/blueprint/src/chapters/ch24-heat-kernel-evolving-metrics.tex","description":"","dependencies":[{"node":"references/ChowEtAl/blueprint/src/chapters/ch24-heat-kernel-evolving-metrics#def:chow-iii-evolving-heat-kernel","title":"def:chow-iii-evolving-heat-kernel","description":""},{"node":"references/ChowEtAl/blueprint/src/chapters/ch24-heat-kernel-evolving-metrics#prop:chow-iii-evolving-parametrix","title":"prop:chow-iii-evolving-parametrix","description":""},{"node":"references/ChowEtAl/blueprint/src/chapters/ch24-heat-kernel-evolving-metrics#lem:chow-iii-parametrix-convolution-derivatives","title":"lem:chow-iii-parametrix-convolution-derivatives","description":""}],"dependencies_omitted":0,"unresolved_dependencies":[],"unresolved_omitted":0}}