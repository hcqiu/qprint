            "file": "tex/Topology/Lin20K3/main.tex",
            "kind": "statement",
            "start_line": 104
          },
          {
            "end_line": 797,
            "file": "tex/Topology/Lin20K3/main.tex",
            "kind": "statement",
            "start_line": 766
          }
        ],
        "formalizations": []
      },
